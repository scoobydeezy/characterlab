  "reuse": {
    "visualSelection": "Existing AttentionSelectionPolicy/519; RolePriority1, EqualPriority2, Unlimited3; capacity remains0..2; Unlimited ignores it.",
    "identity": "Existing DefinitionId/1027 in governed registry envelope; no duplicate definition identity field or namespace.",
    "bodySelection": "GeneralBodySelectionCalibration names the accepted signal gate limits; Capacity<=MaxSignals and complete channel/view coverage are required."
  },
  "refinements": {
    "spatial": "Nonempty rectangle, coordinates0..7, independent focal and residual weights.",
    "encoding": "Fixed homogeneous base3/10 and accepted actor1/target9/10/participant3/5 role factors; Need/Surprise disabled. First recipes use floor1 or1/5 and threshold1/4.",
    "association": "Exact accepted lattice update; decay elapsed from actual LastUpdatedAt, no caller supplied elapsed or coactivation.",
    "access": "Beta strictly below1; matrix dimension<=30; actual current cue and subject-owned leaves only; unavailable cue performs no memory read.",
    "retention": "Independent child-slot budgets; priority reads B0 metadata. No new current credit affects current ranking.",
    "graph": "Nodes<=30 follows the declared30-file public carrier; Edges<=Nodes*(Nodes-1). Weakest-weight-first directed positive edge loss and empty-node normalization unchanged.",
    "feedback": "Exact prior-response1-q peripheral multiplier and1+q association weight; disabled numerical branch retains all producer/delivery checks.",
    "bounds": "CompletedSelectionLimit1..32; positive Horizon<=100 in first cohort; includes empty selectors; not a psychological capacity or memory read.",
    "execution": "UsePlan.ExecutionPolicy resolves the exact declared purpose table. Required policy fields iff corresponding use is requested; no unrelated optional fields. GoalBaselineRecall and GoalQualification iff GoalAssessment is present. BodyCue and goal baseline have independently bound capacities."
  },
