{
  "milestone": "M252",
  "parent": "738d2a8e",
  "card": "c6c5985a",
  "clauses": [
    {
      "id": "BRIEF-12.4-1",
      "text": "uncertain but approximately correct belief;",
      "status": "PARTIAL",
      "retained": "M125/M126 acquired accurate mean; M114/116 scalar uncertainty",
      "remaining": "Confidence must be an explicit native bounded readout, distinct from correctness, with a live consumer."
    },
    {
      "id": "BRIEF-12.4-2",
      "text": "confidently wrong belief;",
      "status": "PARTIAL",
      "retained": "M126 mean1 on8 misleading reports; confidence8/9 only comparator",
      "remaining": "Port accepted support-confidence readout and preserve erroneous belief, resistance and later correction."
    },
    {
      "id": "BRIEF-12.4-3",
      "text": "contradictory evidence;",
      "status": "ESTABLISHED",
      "retained": "M125/M1268+9; M79 conflicting perceived episodes",
      "remaining": "Current composition correspondence and actual consumer, retaining original horizons and no-op controls."
    },
    {
      "id": "BRIEF-12.4-4",
      "text": "hidden cause;",
      "status": "PARTIAL",
      "retained": "M35 latent cause after actual failed attempt",
      "remaining": "Current complete original14-case correspondence; hidden cause evaluated only by researcher."
    },
    {
      "id": "BRIEF-12.4-5",
      "text": "mistaken attribution;",
      "status": "PARTIAL",
      "retained": "M35 wrong diagnostics and correction",
      "remaining": "Require wrong explanation with fixed contrary world, then permitted correction changing actual appraisal/behavior."
    },
    {
      "id": "BRIEF-12.4-6",
      "text": "repeated prediction error;",
      "status": "PARTIAL",
      "retained": "M29 development filter; M114/116 Gated evidence; M126 repeated contradictions",
      "remaining": "Explicit prior-prediction/observed-error/update sequence and actual later consumer; no universal scalar."
    },
    {
      "id": "BRIEF-12.4-7",
      "text": "learning specific action-outcome contingency;",
      "status": "ESTABLISHED",
      "retained": "M29 route-specific performance, M249/M250 acquired action efficacy",
      "remaining": "Map actual action-specific acquired outcomes and unchanged domains; retain belief/skill/physical distinctions."
    },
    {
      "id": "BRIEF-12.4-8",
      "text": "reduced perceived controllability;",
      "status": "PARTIAL",
      "retained": "M36 perceived interference; M74-M79 learned mitigation/control",
      "remaining": "Reduced control must be consumed by appraisal/reason; qualify original controls, not infer from failure alone."
    },
    {
      "id": "BRIEF-12.4-9",
      "text": "evidence later correcting prior attribution.",
      "status": "ESTABLISHED",
      "retained": "M35 later diagnostic correction; M51/M173 retained evidence attribution",
      "remaining": "Current correctable attribution correspondence and preserved prior frozen history."
    }
  ],
  "next": "M253 native proposition-local support/confidence and correction through current social/appraisal path",
  "lawDisposition": "Existing belief-public/0.1 n/(n+1) evidence-weight diagnostic, not calibrated certainty; preserve mean and update, no confidence multiplier or universal uncertainty scalar.",
  "sequence": [
    "Native confidence/correction consumer",
    "Current hidden-cause/misattribution/correction correspondence",
    "Repeated-error/action-contingency/control receiving and finite family acceptance"
  ],
