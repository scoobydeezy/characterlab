      "role": "NARRATIVE"
    },
    {
      "source": "docs/planning/GA_WORK_CEILING_REV1.json",
      "pointer": "/gaLocalBound/priorConcernReplacementLane/inactive/0",
      "text": "current-visual-encoding",
