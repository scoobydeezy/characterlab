      "location": {
        "pointer": "/method/replacementSemantics"
      },
      "text": "Stages whose gate says \"Replace X iff ...\" are mutually exclusive with X; both lanes are evaluated.",
      "category": "NARRATIVE"
    },
    {
      "occurrenceId": "1c4c8f5b3a8d16513210938d620906a65e7cd9ca40604fe9879ecc4bdbf6187f",
